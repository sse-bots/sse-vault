{
  "expo": {
    "name": "SSE Vault",
    "slug": "sse-vault",
    "scheme": "ssevault",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#09090b",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "android": {
      "package": "com.sse.vault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "allowBackup": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SSE Vault to scan 2FA authenticator QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SSE Vault to read a TOTP QR screenshot from your gallery."
        }
      ],
      "./plugins/withSseAutofill",
      "./plugins/withSseUpdater"
    ]
  }
}
