# ==============================================================================
# SSE Vault — TOTP, Password & Backup Security Keys Vault Configuration
# ==============================================================================

# Public URL of this SSE Vault website (no trailing slash)
BETTER_AUTH_URL=https://sse-vault.vercel.app
NEXT_PUBLIC_APP_URL=https://sse-vault.vercel.app

# 32+ byte random secret for signing Vault sessions (separate from SSE Accounts)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=replace_with_a_long_random_secret

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of passwords, TOTP secrets & backup keys
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Keep a backup of this key! Changing it will make existing encrypted entries unreadable.
VAULT_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MongoDB Atlas (can share the same cluster as SSE Accounts, using a dedicated DB)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sse_vault

# ==============================================================================
# Central SSE Accounts OAuth 2.1 / OIDC Client Credentials
# Register this app at: https://sse-account.vercel.app/admin/oauth-clients
# Allowed Redirect URI to add:
#   https://sse-vault.vercel.app/api/auth/callback/sse
# ==============================================================================
SSE_ISSUER_URL=https://sse-account.vercel.app
NEXT_PUBLIC_SSE_ACCOUNTS_URL=https://sse-account.vercel.app
SSE_CLIENT_ID=your_client_id_from_sse_accounts
SSE_CLIENT_SECRET=your_client_secret_from_sse_accounts

# Optional comma-separated extra trusted domains
TRUSTED_ORIGINS=
