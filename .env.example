# ==============================================================================
# SSE Vault v7 — Encrypted Password, Linked OAuth, TOTP & Security Key Manager
# ==============================================================================

# Public URL of this SSE Vault website (no trailing slash)
NEXT_PUBLIC_APP_URL=https://sse-vault-amber.vercel.app

# 32+ byte random secret for encrypting Vault session cookies (falls back to BETTER_AUTH_SECRET)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace_with_a_long_random_secret

# 64-char hex key (32 bytes = AES-256-GCM) used to encrypt passwords, TOTP secrets & backup keys
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
VAULT_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: comma-separated previous 64-char hex keys if you rotate VAULT_ENCRYPTION_SECRET
VAULT_LEGACY_ENCRYPTION_SECRETS=

# Keep true (default) to store each record's `hexcode` in MongoDB as a fallback ONLY
# when VAULT_ENCRYPTION_SECRET changes and fails to decode an older entry.
VAULT_STORE_HEXCODE_IN_DB=true

# MongoDB Atlas (stores ONLY vault_items & vault_pin_configs — zero Better Auth collections!)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sse_vault

# ==============================================================================
# Central SSE Accounts OAuth 2.1 / OIDC Client Credentials
# Register at: https://sse-account.vercel.app/admin/oauth-clients
# Allowed Redirect URI:
#   https://sse-vault-amber.vercel.app/api/auth/callback/sse
# ==============================================================================
SSE_ISSUER_URL=https://sse-account.vercel.app
NEXT_PUBLIC_SSE_ACCOUNTS_URL=https://sse-account.vercel.app
SSE_CLIENT_ID=your_client_id_from_sse_accounts
SSE_CLIENT_SECRET=your_client_secret_from_sse_accounts
